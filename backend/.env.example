# Local backend settings. Copy to backend/.env (git-ignored) and fill in what you want to test.
# The server reads backend/.env on start; real environment variables win. Tests (TESTING=1) ignore it.
# Everything is optional: with an empty file you get a local SQLite DB, mock Google tokens and
# simulated purchases. Production values live in secrets/release.env, not here.

ENVIRONMENT=development

# Default: backend/cozy_doubling.db (SQLite). Set to test against PostgreSQL.
DATABASE_URL=

# Real Google Sign-In from a debug build: the OAuth web client ID (same as GOOGLE_WEB_CLIENT_ID).
GOOGLE_CLIENT_IDS=

# Real "Restore Purchases" check against RevenueCat: the secret sk_ key.
REVENUECAT_SECRET_KEY=

# Real push notifications. Relative paths are relative to backend/.
FIREBASE_CREDENTIALS_FILE=../secrets/firebase-service-account.json
