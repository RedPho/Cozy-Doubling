<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The auth token is encrypted with a non-exportable Keystore key, so a restored copy
     could never be decrypted; local task drafts belong to whoever was signed in on the old device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cozy_doubling_secure_auth.xml" />
        <exclude domain="sharedpref" path="cozy_doubling_tasks.xml" />
        <exclude domain="sharedpref" path="cozy_doubling_focus_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cozy_doubling_secure_auth.xml" />
        <exclude domain="sharedpref" path="cozy_doubling_tasks.xml" />
        <exclude domain="sharedpref" path="cozy_doubling_focus_session.xml" />
    </device-transfer>
</data-extraction-rules>
