<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Never back up the session token or another account's cached tasks. -->
<full-backup-content>
    <exclude domain="sharedpref" path="cozy_doubling_secure_auth.xml" />
    <exclude domain="sharedpref" path="cozy_doubling_tasks.xml" />
    <exclude domain="sharedpref" path="cozy_doubling_focus_session.xml" />
</full-backup-content>
